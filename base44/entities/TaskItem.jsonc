{
  "name": "TaskItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "institution_slug": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "In Progress",
        "Done"
      ],
      "default": "Open"
    },
    "meeting_id": {
      "type": "string"
    },
    "resolution_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "institution_slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.institution_slug": "{{user.data.institution_slug}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "SiteConfig",
  "type": "object",
  "properties": {
    "organisation_name": {
      "type": "string",
      "default": "Ovaherero Traditional Authority"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "office_address": {
      "type": "string"
    },
    "office_hours": {
      "type": "string"
    },
    "footer_note": {
      "type": "string"
    },
    "notice": {
      "type": "string",
      "description": "Site-wide announcement strip"
    },
    "maintenance_mode": {
      "type": "boolean",
      "default": false
    },
    "maintenance_message": {
      "type": "string"
    },
    "membership_card_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
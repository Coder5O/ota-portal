{
  "name": "Institution",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL slug, e.g. chiefs-council"
    },
    "name": {
      "type": "string",
      "description": "Institutional name as approved"
    },
    "native_name": {
      "type": "string",
      "description": "Otjiherero or customary name where applicable"
    },
    "summary": {
      "type": "string",
      "description": "Short public summary"
    },
    "mandate": {
      "type": "string",
      "description": "Published mandate, drawn from the Constitution only"
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reporting_line": {
      "type": "string",
      "description": "Reporting arrangement as approved"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "slug",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
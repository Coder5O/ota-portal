{
  "name": "ConstitutionArticle",
  "type": "object",
  "properties": {
    "number": {
      "type": "number",
      "description": "Article number"
    },
    "title": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Article text exactly as adopted"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "number",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
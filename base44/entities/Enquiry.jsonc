{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "General enquiry",
        "Profile correction",
        "Document request",
        "Membership query",
        "Media request"
      ],
      "default": "General enquiry"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "In Review",
        "Resolved",
        "Closed"
      ],
      "default": "New"
    },
    "assigned_to": {
      "type": "string"
    },
    "response": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
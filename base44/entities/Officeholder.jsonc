{
  "name": "Officeholder",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Official title as approved"
    },
    "institution_slug": {
      "type": "string"
    },
    "portfolio": {
      "type": "string"
    },
    "community_name": {
      "type": "string"
    },
    "biography": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "appointed_date": {
      "type": "string"
    },
    "term_end": {
      "type": "string"
    },
    "public_contact": {
      "type": "string"
    },
    "member_email": {
      "type": "string",
      "description": "Optional link to a member record"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "hidden"
      ],
      "default": "hidden"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}